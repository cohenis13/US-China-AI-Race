# Copy this file to .env.local to use local data files during development.
# This makes the Next.js app read from /api/data/* (served from data/*.json)
# instead of V1's production URL.
#
# Usage:
#   cp .env.local.example .env.local
#   pnpm dev
#
# The app will then reflect your local data/*.json changes immediately.

DATA_BASE=http://localhost:3000/api/data
